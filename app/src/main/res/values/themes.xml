<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SnackStream" parent="Theme.Material3.DayNight.NoActionBar">

    </style>

    <style name="Theme.SnackStream" parent="Base.Theme.SnackStream">
        <!-- Outline (unfocused) -->
        <item name="colorOutline">@color/glass_border</item>
        <!-- Focused stroke -->
        <item name="colorPrimary">@color/glass_border</item>
        <!-- Hint (THIS is the real fix) -->
        <item name="colorOnSurfaceVariant">@color/glass_border</item>
    </style>

<!--    Splash Screen   -->
    <style name="SplashScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splashscreen</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Base Styles for Dot Notation Inheritance -->
    <style name="MyTextStyle" />
    <style name="MyEditTextStyle" />

    <style name="MyTextStyle.heading1">
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textColorPrimary</item>
    </style>

    <style name="MyTextStyle.heading2">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textColorPrimary</item>
    </style>

    <style name="MyTextStyle.heading3">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textColorPrimary</item>
    </style>

    <style name="MyTextStyle.normal_text">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/textColorSecondary</item>
    </style>

    <style name="logo_dimes">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
    </style>

<!--  EditText Styles  -->

    <style name="MyEditTextStyle.glassy">

    </style>

    <style name="MyEditTextStyle.outlinedBox"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextColor">@color/textColorPrimary</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="expandedHintEnabled">false</item>
    </style>

<!--  Primary Button Style -->
    <style name="MyButtonStyle.Primary"
        parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:elevation">8dp</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">30dp</item>
    </style>

    <style name="MyButtonStyle.Primary2"
        parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:elevation">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">24dp</item>
    </style>


</resources>