<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.snackstream.activities.fragments.ProfileFragment"
        android:label="Profile">
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.snackstream.activities.fragments.HomeFragment"
        android:label="Home"/>

    <fragment
        android:id="@+id/addStoryFragment"
        android:name="com.example.snackstream.activities.fragments.AddStoryFragment"
        android:label="Add Story"
        tools:layout="@layout/fragment_add_story"/>

    <fragment
        android:id="@+id/reelsFragment"
        android:name="com.example.snackstream.activities.fragments.ReelFragment"
        android:label="Reels"/>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.snackstream.activities.fragments.SearchFragment"
        android:label="Search"/>

    <fragment
        android:id="@+id/offlineFragment"
        android:name="com.example.snackstream.activities.fragments.OfflineFragment"
        android:label="Search"/>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.snackstream.activities.fragments.CartFragment"
        android:label="cart"/>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.example.snackstream.activities.fragments.CheckoutFragment"
        android:label="Checkout">
        <argument
            android:name="totalAmount"
            app:argType="float" />
    </fragment>

    <fragment
        android:id="@+id/uploadReelFragment"
        android:name="com.example.snackstream.activities.fragments.UploadReelFragment"
        android:label="Upload Reel">
        <argument
            android:name="videoUri"
            app:argType="string" />
    </fragment>


</navigation>