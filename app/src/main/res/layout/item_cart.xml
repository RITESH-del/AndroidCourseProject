<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#221410"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="top">

        <!-- Food Image -->
        <ImageView
            android:id="@+id/ivFoodImage"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_food_image"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_food_placeholder"
            android:contentDescription="Food Item"
            android:layout_marginEnd="12dp" />

        <!-- Item Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Double Truffle Burger"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/syne_semibold"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/tvItemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Extra caramelized onions, no pickles"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3" />

            <!-- Quantity + Price Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <!-- Quantity Control -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_qty_control"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/btnDecrease"
                        android:layout_width="32dp"
                        android:layout_height="30dp"
                        android:text="−"
                        android:textColor="@color/accent_red"
                        android:textSize="18sp"
                        android:fontFamily="@font/dm_sans_semibold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="@font/syne_semibold"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/btnIncrease"
                        android:layout_width="32dp"
                        android:layout_height="30dp"
                        android:text="+"
                        android:textColor="@color/accent_red"
                        android:textSize="18sp"
                        android:fontFamily="@font/dm_sans_semibold"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Item Price -->
                <TextView
                    android:id="@+id/tvItemPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$18.50"
                    android:textColor="@color/accent_orange"
                    android:textSize="15sp"
                    android:fontFamily="@font/syne_bold"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_delete_button"
            android:src="@drawable/ic_delete"
            android:tint="@color/accent_red"
            android:contentDescription="Remove item"
            android:padding="6dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
